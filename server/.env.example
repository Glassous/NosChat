MODEL_3=id=GPT OSS 120B;model=GPT OSS 120B;name=GPT OSS 120B;provider=OpenAI;icon=🛰️;badge=开源旗舰;color=#10a37f;desc=OpenAI 2025 年 8 月发布的开源权重模型：120B MoE 面向本地与私有部署，是 OpenAI 罕见的开放权重尝试，当时被视为行业风向的转变。;tags=怀旧,MoE,本地部署;context=128K;released=2025-08-05;speed=2;intelligence=3;temp=0.7;reasoning=false;latency=1200-2400
MODEL_4=id=GPT OSS 20B;model=GPT OSS 20B;name=GPT OSS 20B;provider=OpenAI;icon=📡;badge=轻量开源;color=#0ea5e9;desc=与 120B 同日发布的轻量版本，20B 规模可单卡运行，是当时「本地跑大厂模型」的代表，常被用作端侧与 Agent 实验底座。;tags=怀旧,轻量,端侧;context=128K;released=2025-08-05;speed=4;intelligence=2;temp=0.7;reasoning=false;latency=500-1100
MODEL_5=id=Gemma 2 27B;model=Gemma 2 27B;name=Gemma 2 27B;provider=Google;icon=💎;badge=开源;color=#1a73e8;desc=Google 2024 年 7 月开源的 Gemma 2 中量级版本，以同规模突出的性价比著称，是当年个人开发者与学术实验的热门选择。;tags=怀旧,开源,微调基座;context=8K;released=2024-07-13;speed=3;intelligence=2;temp=0.7;reasoning=false;latency=900-1800
MODEL_6=id=Llama 3.1 70B Instruct;model=Llama 3.1 70B Instruct;name=Llama 3.1 70B Instruct;provider=Meta;icon=🦙;badge=开源经典;color=#0668e3;desc=Meta 2024 年 7 月发布的开源旗舰：128K 上下文与接近闭源的综合表现，长期是自建服务与微调的事实标准。;tags=怀旧,开源,英文强;context=128K;released=2024-07-23;speed=2;intelligence=2;temp=0.7;reasoning=false;latency=1100-2200
MODEL_7=id=Qwen 2.5 72B Instruct;model=Qwen 2.5 72B Instruct;name=Qwen 2.5 72B Instruct;provider=阿里云;icon=🔮;badge=中文强;color=#ff6a00;desc=阿里 2024 年 9 月发布的中文强模型：中文理解与代码能力在同规模领先，是当时国内私有化部署与中文微调的首选基座。;tags=怀旧,中文,可私有化;context=128K;released=2024-09-19;speed=3;intelligence=2;temp=0.7;reasoning=false;latency=1000-1900
MODEL_8=id=Qwen3 235B A22B;model=Qwen3 235B A22B;name=Qwen3 235B A22B;provider=阿里云;icon=🧩;badge=超大规模;color=#14b8a6;desc=阿里 2025 年 7 月发布的超大 MoE 模型，支持思考/非思考双模式，以 235B 总参数成为当时开源阵营的规模之最。;tags=怀旧,MoE,推理;context=128K;released=2025-07-21;speed=2;intelligence=3;temp=0.6;reasoning=true;latency=1400-2600
MODEL_9=id=Mistral Nemo;model=Mistral Nemo;name=Mistral Nemo;provider=Mistral AI;icon=🌬️;badge=端侧友好;color=#f97316;desc=Mistral 与 NVIDIA 合作的 12B 模型（2024 年 7 月）：端侧友好、支持 128K 上下文，是当时小模型微调与本地部署的热门底座。;tags=怀旧,轻量,微调基座;context=128K;released=2024-07-19;speed=4;intelligence=2;temp=0.7;reasoning=false;latency=500-1200

# 方式二：使用 JSON 配置文件（未定义任何 MODEL_* 时生效）
MODELS_CONFIG_PATH=config/models.json
