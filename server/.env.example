# ============ NosChat 后端环境变量样例 ============
# 复制为 server/.env 后按需修改（这是后端唯一的配置文件，.env 已被 .gitignore 忽略）
# 本地运行：cd server && python run.py
# 容器部署：docker compose up -d --build（compose 直接读取本文件）

# ---- 应用 ----
PORT=9135
DEBUG=false
# 允许跨域访问后端的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TZ=Asia/Shanghai

# ---- PostgreSQL ----
# 本地(非容器)运行：localhost:5432
# 容器内：compose 会把 POSTGRES_HOST 覆盖为服务名 db，这里无需改动
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=noschat
POSTGRES_PASSWORD=noschat
POSTGRES_DB=noschat
# 也可以直接给完整连接串（一旦设置则优先于上面的分片配置）
# DATABASE_URL=postgresql+psycopg://noschat:noschat@localhost:5432/noschat

# ---- OpenAI 兼容模型服务（一个 base url + 一个 key + 多个 model）----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key
OPENAI_TIMEOUT=120
# 是否遵循系统代理环境变量（本机代理软件会拦截 127.0.0.1/内网模型服务，默认关闭）
OPENAI_TRUST_ENV=false

# ---- 鉴权 ----
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# ---- SMTP 邮件 ----
# 账号字段支持两种写法：SMTP_USER/SMTP_PASS 或 SMTP_USERNAME/SMTP_PASSWORD
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
# 发件地址支持 "显示名 <地址>" 形式，也可只写地址并与 SMTP_FROM_NAME 组合
SMTP_FROM=NosChat <no-reply@example.com>
SMTP_FROM_NAME=NosChat
# 587 -> STARTTLS=true / SSL=false；465 -> SSL=true / STARTTLS=false（QQ、163 等邮箱）
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=15
# 未配置 SMTP 时是否把验证码回传给前端（仅本地开发使用，生产必须为 false）
AUTH_DEV_ECHO_CODE=false

# ---- 验证码策略 ----
CODE_LENGTH=6
CODE_TTL_SECONDS=300
CODE_RESEND_INTERVAL_SECONDS=60
CODE_MAX_ATTEMPTS=5

# ---- Redis（缓存 + 限流）----
# 留空即整体禁用：缓存直接回源数据库，限流走进程内兜底
# 本地(非容器)运行：localhost:6379；容器内由 compose 覆盖为服务名 redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=noschat
# 单次 Redis 操作超时（秒）与熔断时长（秒）：Redis 异常时在该窗口内直接降级
REDIS_SOCKET_TIMEOUT=0.5
REDIS_RETRY_SECONDS=30
# 模型清单缓存 / 额度快照缓存 的 TTL（秒）
CATALOG_CACHE_SECONDS=300
QUOTA_CACHE_SECONDS=10

# ---- 每用户每日输出 token 额度 ----
# 只统计模型输出（thinking + content），输入 token 不计；
# 额度用尽前放行的最后一轮会完整跑完（允许略微超出），之后直到重置前一律拒绝
DAILY_OUTPUT_TOKEN_LIMIT=100000
# 额度按该时区的自然日重置（依赖 tzdata，缺失时回退 UTC）
QUOTA_TIMEZONE=Asia/Shanghai

# ---- 限流 ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SEND_CODE_RATE_LIMIT_PER_IP=20
SEND_CODE_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_PER_IP=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
CHAT_RATE_LIMIT_PER_USER=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ---- 反向代理 ----
# 容器部署务必保留 "*"：经 docker-proxy 转发后对端是网桥网关 IP，
# 不信任代理会导致 X-Forwarded-For 被忽略、所有客户端看起来是同一个 IP
FORWARDED_ALLOW_IPS=*

# ---- 上游流式用量上报 ----
# 是否向上游请求 stream_options.include_usage（部分第三方网关不认该参数，
# 保持 false 时仍会机会式读取上游返回的 usage，缺失则按字符估算）
OPENAI_STREAM_USAGE=false

# ============ 模型清单（二选一）============
# 方式一（推荐）：在 .env 里维护，语法 MODEL_<编号>=字段=值;字段=值…
#   字段名与 config/models.json 一致；只要定义了任意 MODEL_*，config/models.json 会被忽略
#   可用字段：id(必填) model(上游模型名) name provider icon badge color desc tags context
#             released speed(1-5) intelligence(1-5) temp reasoning latency(如 600-1200) base_url
#   提示：`python scripts/export_models_env.py` 可从 models.json 生成下面的行
MODEL_1=id=DeepSeek V3 0324;model=DeepSeek V3 0324;name=DeepSeek V3 0324;provider=深度求索;icon=🐋;badge=经典 MoE;color=#4d6bfe;desc=2025 年 3 月的 V3 升级版：671B MoE 架构与极低的推理成本，第一次让开源模型在通用能力上与闭源旗舰正面竞争，并带火了开源模型的小版本迭代节奏。;tags=怀旧,MoE,开源;context=128K;released=2025-03-24;speed=3;intelligence=3;temp=0.7;reasoning=false;latency=800-1600
