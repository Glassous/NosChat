# ============ docker-compose 环境变量样例 ============
# 复制为根目录 .env 后按需修改（.env 已被 .gitignore 忽略）
# 说明：这里只服务「后端 + PostgreSQL」容器，前端不在容器内。

# ---- 后端 ----
PORT=9135
DEBUG=false
# 允许跨域访问后端的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- PostgreSQL ----
POSTGRES_USER=noschat
POSTGRES_PASSWORD=noschat
POSTGRES_DB=noschat
# 取消 docker-compose.yml 中 db.ports 注释后，可指定宿主机端口
# POSTGRES_PORT=5432
TZ=Asia/Shanghai

# ---- OpenAI 兼容模型服务（一个 base url + 一个 key + 多个 model）----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key
OPENAI_TIMEOUT=120
# 是否遵循系统代理环境变量（默认 false，避免代理拦截内网/本地模型服务）
OPENAI_TRUST_ENV=false

# ---- 鉴权（必填）----
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# ---- SMTP 邮件 ----
# 账号字段支持两种写法：SMTP_USER/SMTP_PASS 或 SMTP_USERNAME/SMTP_PASSWORD
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
# 发件地址支持 "显示名 <地址>" 形式，也可只写地址并与 SMTP_FROM_NAME 组合
SMTP_FROM=NosChat <no-reply@example.com>
SMTP_FROM_NAME=NosChat
# 587 -> STARTTLS=true / SSL=false；465 -> SSL=true / STARTTLS=false（如 QQ、163 邮箱）
SMTP_STARTTLS=true
SMTP_SSL=false
# 未配置 SMTP 时是否把验证码回传前端（仅本地开发使用，生产必须为 false）
AUTH_DEV_ECHO_CODE=false

# ---- 验证码策略 ----
CODE_TTL_SECONDS=300
CODE_RESEND_INTERVAL_SECONDS=60
